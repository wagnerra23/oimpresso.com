{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "Norte/**",
              "components/Alert/**",
              "components/AppSidebar/**",
              "components/Avatar/**",
              "components/BoardColumn/**",
              "components/Breadcrumb/**",
              "components/BulkBar/**",
              "components/Button/**",
              "components/Chart/**",
              "components/Checkbox/**",
              "components/ColumnManager/**",
              "components/Command/**",
              "components/DataGrid/**",
              "components/DataTable/**",
              "components/DataTablePro/**",
              "components/DatePicker/**",
              "components/Dimension/**",
              "components/Drawer/**",
              "components/DropdownMenu/**",
              "components/EmptyState/**",
              "components/FilterChip/**",
              "components/FsmStepper/**",
              "components/Input/**",
              "components/Kebab/**",
              "components/KpiCard/**",
              "components/KpiFilterCard/**",
              "components/Logo/**",
              "components/Modal/**",
              "components/PageHeader/**",
              "components/Pagination/**",
              "components/PeriodBar/**",
              "components/PlacaVeiculo/**",
              "components/PresenterMode/**",
              "components/Progress/**",
              "components/ProofFrame/**",
              "components/ProofStrip/**",
              "components/RadioGroup/**",
              "components/RegistrationMark/**",
              "components/Segmented/**",
              "components/Skeleton/**",
              "components/StatusBadge/**",
              "components/Switch/**",
              "components/TabBar/**",
              "components/TagChip/**",
              "components/TaskCard/**",
              "components/Timeline/**",
              "components/Toast/**",
              "components/Toolbar/**",
              "components/Tooltip/**",
              "components/Widget/**",
              "public/cowork-preview/erp-shell-v2/**",
              "ui_kits/app/**",
              "ui_kits/site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IBM Plex Sans|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: IBM Plex Sans, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|children|icon|action|onClose|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: tone, title, children, icon, action, onClose."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|success|warn|danger)$/]",
        "message": "<Alert> tone must be one of 'info' | 'success' | 'warn' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppSidebarBusiness'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|nome|iniciais|ativa|key|ref|className|style|children)$/]",
