{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oimpresso.com/schemas/design-bundle-v2.json",
  "title": "OImpressO Design bundle v2",
  "oneOf": [
    { "$ref": "#/$defs/manifest" },
    { "$ref": "#/$defs/part" },
    { "$ref": "#/$defs/applicationReport" },
    { "$ref": "#/$defs/applications" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": { "type": "string", "minLength": 1, "not": { "pattern": "(^|/)\\.\\.(/|$)|^/|^[A-Za-z]:" } },
    "file": {
      "type": "object",
      "required": ["path", "bytes", "sha256", "role"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "role": { "enum": ["cowork-source", "design-doc", "preview-cache"] }
      },
      "additionalProperties": false
    },
    "changes": {
      "type": "object",
      "required": ["added", "modified", "deleted", "unchanged"],
      "properties": {
        "added": { "type": "array", "items": { "$ref": "#/$defs/path" }, "uniqueItems": true },
        "modified": { "type": "array", "items": { "$ref": "#/$defs/path" }, "uniqueItems": true },
        "deleted": { "type": "array", "items": { "$ref": "#/$defs/path" }, "uniqueItems": true },
        "unchanged": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "required": ["schema", "bundleId", "baseBundleId", "mode", "source", "entry", "generatedAt", "files", "missing", "changes", "totals"],
      "properties": {
        "schema": { "const": "oimpresso-design-manifest/2" },
        "bundleId": { "$ref": "#/$defs/sha256" },
        "baseBundleId": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "mode": { "enum": ["snapshot", "delta"] },
        "source": { "type": "string", "minLength": 1 },
        "entry": { "$ref": "#/$defs/path" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "files": { "type": "array", "items": { "$ref": "#/$defs/file" } },
        "missing": { "type": "array", "items": { "$ref": "#/$defs/path" }, "uniqueItems": true },
        "changes": { "$ref": "#/$defs/changes" },
        "totals": {
          "type": "object",
          "required": ["files", "bytes"],
          "properties": { "files": { "type": "integer", "minimum": 0 }, "bytes": { "type": "integer", "minimum": 0 } },
          "additionalProperties": false
        }
      }
    },
    "chunk": {
      "type": "object",
      "required": ["path", "index", "count", "offset", "bytes", "sha256", "content"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "index": { "type": "integer", "minimum": 1 },
        "count": { "type": "integer", "minimum": 1 },
        "offset": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "content": { "type": "string", "contentEncoding": "base64" }
      }
    },
    "part": {
      "type": "object",
      "required": ["schema", "bundle", "part", "parts", "chunks"],
      "properties": {
        "schema": { "const": "oimpresso-design-bundle/2" },
        "bundle": { "type": "object", "required": ["id", "baseId", "mode", "parts", "manifestSha256", "changesSha256"] },
        "part": { "type": "integer", "minimum": 1 },
        "parts": { "type": "integer", "minimum": 1 },
        "targetManifest": { "$ref": "#/$defs/manifest" },
        "chunks": { "type": "array", "items": { "$ref": "#/$defs/chunk" } }
      }
    },
    "applicationReport": {
      "type": "object",
      "required": ["schema", "bundle", "summary", "transportChanges", "screens"],
      "properties": { "schema": { "const": "oimpresso-design-application-report/3" } }
    },
    "testReceipt": {
      "type": "object",
      "required": ["command", "exitCode", "runner", "outputSha256", "sourceSha256", "targetSha256", "recordedAt"],
      "properties": {
        "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "exitCode": { "const": 0 },
        "runner": { "enum": ["local", "ct100", "ci"] },
        "outputSha256": { "$ref": "#/$defs/sha256" },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "targetSha256": { "$ref": "#/$defs/sha256" },
        "recordedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "smokeReceipt": {
      "type": "object",
      "required": ["route", "deploySha", "tenant", "screenshot", "screenshotSha256", "result", "targetSha256", "recordedAt"],
      "properties": {
        "route": { "type": "string", "pattern": "^/" },
        "deploySha": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "tenant": { "const": 1 },
        "screenshot": { "$ref": "#/$defs/path" },
        "screenshotSha256": { "$ref": "#/$defs/sha256" },
        "result": { "const": "passed" },
        "targetSha256": { "$ref": "#/$defs/sha256" },
        "recordedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "applications": {
      "type": "object",
      "required": ["schema", "applications"],
      "properties": {
        "schema": { "const": "oimpresso-design-applications/2" },
        "applications": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "target", "sourceSha256", "targetSha256", "tests", "smokes"],
            "properties": {
              "source": { "$ref": "#/$defs/path" },
              "target": { "$ref": "#/$defs/path" },
              "sourceSha256": { "$ref": "#/$defs/sha256" },
              "targetSha256": { "$ref": "#/$defs/sha256" },
              "comparison": {
                "type": "object",
                "required": ["map", "mapSha256", "recordedAt"],
                "properties": {
                  "map": { "$ref": "#/$defs/path" },
                  "mapSha256": { "$ref": "#/$defs/sha256" },
                  "recordedAt": { "type": "string", "format": "date-time" }
                }
              },
              "application": {
                "type": "object",
                "properties": {
                  "evidence": { "$ref": "#/$defs/path" },
                  "evidenceSha256": { "$ref": "#/$defs/sha256" },
                  "recordedAt": { "type": "string", "format": "date-time" },
                  "legacyUnverified": { "const": true }
                },
                "oneOf": [
                  { "required": ["evidence", "evidenceSha256", "recordedAt"], "not": { "required": ["legacyUnverified"] } },
                  { "required": ["legacyUnverified"] }
                ],
                "additionalProperties": false
              },
              "legacyTests": { "type": "array", "items": { "type": "string" } },
              "tests": { "type": "array", "items": { "$ref": "#/$defs/testReceipt" } },
              "smokes": { "type": "array", "items": { "$ref": "#/$defs/smokeReceipt" } }
            },
            "additionalProperties": false
          }
        }
      }
    }
  }
}
